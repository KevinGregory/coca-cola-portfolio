# .env.example
# Copied pattern from Alfred (github.com/KevinGregory/alfred).
#
# Copy this file to .env and fill in your keys.
# Never commit .env to git — it's in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your keys
#   uv run portfolio

# Required — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — only needed if using --backend openai
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Image backend: stub (default) | openai
# stub = generates SVG mockups, no API key needed, works offline
# openai = generates real images with gpt-image-1 (~$0.02/image)
COCA_IMAGE_BACKEND=stub

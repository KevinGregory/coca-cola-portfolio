# Required
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...        # aistudio.google.com/app/apikey — used by Gemini 2.5 Flash summarizer

# Required if ALFRED_IMAGE_BACKEND=openai (default)
OPENAI_API_KEY=sk-...

# Required only if ALFRED_IMAGE_BACKEND=replicate
REPLICATE_API_TOKEN=r8_...

# openai | replicate | stub
# `stub` writes placeholder SVGs and needs no image API key — good for testing the pipeline.
ALFRED_IMAGE_BACKEND=openai
